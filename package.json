{
  "name": "nerv-tunnel",
  "version": "0.3.0",
  "author": {
    "name": "Denis Chen",
    "url": "https://github.com/eripley"
  },
  "license": "MIT",
  "description": "Set up reverse SSH tunnels with your agent and monitor them from your terminal",
  "type": "module",
  "bin": {
    "nerv": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "os": [
    "darwin"
  ],
  "files": [
    "dist",
    "docs",
    "README.ru.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "lint": "eslint --max-warnings=0 .eslintrc.cjs \"src/**/*.{ts,tsx}\" \"scripts/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.tools.json",
    "format:check": "prettier --check .eslintrc.cjs src scripts/*.ts test .github/workflows package.json tsconfig*.json jest.config.json",
    "coverage": "npm run build && npm run test:coverage",
    "test:coverage": "c8 --all --include=\"dist/*.js\" --reporter=text --reporter=lcovonly --reporter=json-summary node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand && node --experimental-strip-types scripts/coverage-badge.ts",
    "check:pack": "node --experimental-strip-types scripts/check-pack.ts"
  },
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "chalk": "5.6.2",
    "commander": "^15.1.0",
    "ink": "^6.8.0",
    "react": "^19.1.1",
    "semver": "^7.8.6",
    "wrap-ansi": "9.0.2"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/semver": "^7.8.0",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "c8": "^12.0.0",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "ink-testing-library": "^4.0.0",
    "jest": "^30.5.2",
    "prettier": "^3.10.1",
    "ts-jest": "^29.4.15",
    "typescript": "~5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eripley/nerv-tunnel.git"
  }
}
